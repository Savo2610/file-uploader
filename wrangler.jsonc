{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Der Name muss exakt dem Worker-Namen im Cloudflare-Dashboard entsprechen,
  // sonst legt ein Build einen zweiten Worker an.
  "name": "upload",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",

  // run_worker_first, weil unter den zwei Hostnamen unterschiedliche Seiten
  // ausgeliefert werden: sonst würde Cloudflare public/index.html beantworten,
  // bevor der Worker überhaupt gefragt wird.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Zwei getrennte Adressen, ein Worker:
  //   upload.veerka.mp   – öffentlich, nur Hochladen
  //   download.veerka.mp – nur mit 2FA-Code, zum Abholen
  "routes": [
    { "pattern": "upload.veerka.mp", "custom_domain": true },
    { "pattern": "download.veerka.mp", "custom_domain": true }
  ],

  // Hier landen die hochgeladenen Dateien. Der Bucket ist nicht öffentlich
  // erreichbar; herausholen kann sie nur, wer einen gültigen 2FA-Code hat.
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "upload-veerka-mp" }
  ],

  // Protokoll, Tageskontingent und Zustand laufender Uploads.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "upload-meta",
      "database_id": "9f73fd46-7f9f-448f-8d4b-5a5b5d4326a1"
    }
  ],

  // Nächtlicher Aufräumlauf: löscht Dateien, die älter als die Aufbewahrungs-
  // frist in src/index.js sind. 4:07 UTC, damit es nicht zur vollen Stunde
  // gemeinsam mit allen anderen Cron-Jobs der Welt losgeht.
  "triggers": { "crons": ["7 4 * * *"] },

  "observability": { "enabled": true }
}
